<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Portal Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">

    <!-- Top Navigation Bar -->
    <header class="bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between sticky top-0 z-50">
        <div class="flex items-center space-x-3">
            <div class="h-8 w-8 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold text-xl">Ω</div>
            <span class="font-bold text-lg tracking-tight">CustomPay</span>
        </div>
        <div class="flex items-center space-x-4">
            <span class="inline-flex items-center bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                <span class="w-2 h-2 bg-green-500 rounded-full mr-1.5"></span>Live Mode
            </span>
            <div class="h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center text-gray-600 font-semibold">
                AA
            </div>
        </div>
    </header>

    <main class="max-w-4xl mx-auto p-4 md:p-8 space-y-6">
        
        <!-- Breadcrumb navigation mirroring image.png -->
        <nav class="text-sm text-gray-500 flex items-center space-x-2">
            <span class="hover:underline cursor-pointer">Transactions</span>
            <span>&rsaquo;</span>
            <span class="text-gray-800 font-medium">6288519455</span>
        </nav>

        <!-- Main Grid Layout -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <!-- Left & Center Column: Transaction Receipt (from image.png) -->
            <div class="md:col-span-2 space-y-6">
                <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
                    <div class="p-6 border-b border-gray-100 flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Amount Received</p>
                            <h1 class="text-3xl font-bold text-gray-900 mt-1">GHS 810.10</h1>
                        </div>
                        <span class="bg-green-100 text-green-700 font-semibold text-sm px-3 py-1 rounded-full">Success</span>
                    </div>

                    <!-- Receipt Details Table -->
                    <div class="p-6 space-y-4 text-sm">
                        <div class="flex justify-between py-2 border-b border-gray-50">
                            <span class="text-gray-500">Reference</span>
                            <span class="font-mono text-gray-900 flex items-center gap-1.5">dfxsdg9fe9omqpe59yt <i class="fa-regular fa-copy text-gray-400 cursor-pointer hover:text-gray-600"></i></span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-50">
                            <span class="text-gray-500">Receipt Number</span>
                            <span class="font-mono text-gray-900 flex items-center gap-1.5">83868552792 <i class="fa-regular fa-copy text-gray-400 cursor-pointer hover:text-gray-600"></i></span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-50">
                            <span class="text-gray-500">Channel</span>
                            <span class="font-medium text-gray-900">Mobile Money</span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-50">
                            <span class="text-gray-500">Paid At</span>
                            <span class="text-gray-900">Jun 22, 2026, 3:53 PM UTC</span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-50">
                            <span class="text-gray-500">Gateway Message</span>
                            <span class="text-green-600 font-medium">Approved</span>
                        </div>
                    </div>

                    <!-- Customer Info Box -->
                    <div class="bg-gray-50 p-4 border-t border-gray-100 flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="h-9 w-9 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-600">
                                <i class="fa-solid fa-user-tag text-sm"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400">Customer Email</p>
                                <p class="text-sm font-medium text-gray-700">alexanderasiamah363@gmail.com</p>
                            </div>
                        </div>
                        <button class="text-xs font-semibold text-red-500 hover:text-red-700 transition">Flag Customer</button>
                    </div>
                </div>

                <!-- Custom Deductions, Payout Breakdown & Hold Notice -->
                <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-xl p-6 shadow-sm space-y-4">
                    <h3 class="font-bold text-lg border-b border-slate-700 pb-3"><i class="fa-solid fa-calculator text-indigo-400 mr-2"></i>Fee & Settlement Analysis</h3>
                    
                    <div class="space-y-3 text-sm">
                        <div class="flex justify-between text-slate-400">
                            <span>Gross Transaction Value</span>
                            <span class="font-medium text-white">GHS 810.10</span>
                        </div>
                        <div class="flex justify-between text-slate-400">
                            <span>Processing Charge</span>
                            <span class="font-medium text-rose-400">- GHS 20.00</span>
                        </div>
                        <div class="flex justify-between text-slate-400 items-start">
                            <div>
                                <span>First-Time Maintenance Fee</span>
                                <span class="block text-xs text-amber-400 font-normal mt-0.5">Fixed Gateway Activation ($30.00)</span>
                            </div>
                            <span class="font-medium text-rose-400">- GHS 450.00</span>
                        </div>
                        
                        <div class="pt-3 border-t border-slate-700 flex justify-between items-center">
                            <span class="font-semibold text-base">Net Payout Balance</span>
                            <span class="text-xl font-bold text-emerald-400">GHS 340.10</span>
                        </div>
                    </div>

                    <!-- System Compliance Notice -->
                    <div class="mt-4 bg-slate-800/60 border border-slate-700 rounded-lg p-4 text-xs text-slate-300 leading-relaxed space-y-3">
                        <div>
                            <p class="font-semibold text-amber-400 mb-1 flex items-center">
                                <i class="fa-solid fa-circle-info mr-1.5"></i> Why was the activation charge applied?
                            </p>
                            <p>
                                Because this is your <strong>first merchant transaction</strong> on this profile, a one-time structural maintenance and gateway security provisioning charge of $30.00 (converted at current platform exchange rules to GHS 450.00) has been fully subtracted alongside your GHS 20.00 processing charge. Future transactions will only undergo standard localized processing fees.
                            </p>
                        </div>
                        
                        <div class="pt-2 border-t border-slate-700/60">
                            <p class="font-semibold text-rose-400 mb-1 flex items-center">
                                <i class="fa-solid fa-triangle-exclamation mr-1.5"></i> Important: Payout Hold Notice
                            </p>
                            <p class="text-slate-400">
                                Please be advised that <strong class="text-white">your payout is currently on hold</strong> because your identity verification document (<span class="text-white">Ghana Card</span>) has been detected to be linked to different suspicious accounts under different registration names. 
                            </p>
                            <div class="mt-3 flex items-center justify-between bg-slate-900/50 p-2.5 rounded border border-rose-500/20">
                                <span class="text-rose-300 font-medium">Action Required: Please submit your proof of accuracy</span>
                                <button class="bg-rose-600 hover:bg-rose-700 text-white font-semibold px-3 py-1 rounded text-[11px] transition">
                                    Upload Proof
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Analytics Timeline (from image_2.png) -->
            <div class="space-y-6">
                <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6">
                    <h3 class="font-bold text-gray-900 text-base pb-2 border-b border-gray-100">Metadata Details</h3>
                    
                    <!-- Metadata Rows -->
                    <div class="space-y-4 text-xs">
                        <div>
                            <span class="text-gray-400 block mb-0.5">Mobile Money Number</span>
                            <span class="font-medium text-gray-900 text-sm">0538071894</span>
                        </div>
                        <div>
                            <span class="text-gray-400 block mb-0.5">Provider / Country</span>
                            <span class="font-medium text-gray-900 text-sm">MTN (GH)</span>
                        </div>
                        <div>
                            <span class="text-gray-400 block mb-0.5">Authorization Code</span>
                            <span class="font-mono text-gray-900 bg-gray-50 px-1.5 py-0.5 rounded border border-gray-100">AUTH_rcxm64qfsq</span>
                        </div>
                        <div>
                            <span class="text-gray-400 block mb-0.5">IP Address</span>
                            <span class="font-medium text-indigo-600">154.160.9.153</span>
                        </div>
                    </div>

                    <hr class="border-gray-100">

                    <!-- Metrics Grid -->
                    <div class="grid grid-cols-2 gap-4 text-center">
                        <div class="bg-gray-50 p-3 rounded-lg border border-gray-100">
                            <span class="block text-xl font-bold text-gray-800">33s</span>
                            <span class="text-[10px] text-gray-400 uppercase tracking-wider">Duration</span>
                        </div>
                        <div class="bg-gray-50 p-3 rounded-lg border border-gray-100">
                            <span class="block text-xl font-bold text-gray-800">1</span>
                            <span class="text-[10px] text-gray-400 uppercase tracking-wider">Attempt</span>
                        </div>
                    </div>

                    <hr class="border-gray-100">

                    <!-- Transaction Event Timeline Logs -->
                    <div>
                        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Event Log Timeline</h4>
                        <ol class="relative border-l border-gray-200 ml-2 space-y-4 text-xs">                  
                            <li class="mb-4 ml-4">
                                <div class="absolute w-2.5 h-2.5 bg-indigo-600 rounded-full -left-[5px] top-1"></div>
                                <time class="text-gray-400 font-mono">00:04</time>
                                <p class="text-gray-700 font-medium mt-0.5">Set payment method to: mobile_money</p>
                            </li>
                            <li class="mb-4 ml-4">
                                <div class="absolute w-2.5 h-2.5 bg-indigo-600 rounded-full -left-[5px] top-1"></div>
                                <time class="text-gray-400 font-mono">00:14</time>
                                <p class="text-gray-700 font-medium mt-0.5">Attempted to pay with mobile money</p>
                            </li>
                            <li class="mb-4 ml-4">
                                <div class="absolute w-2.5 h-2.5 bg-amber-500 rounded-full -left-[5px] top-1"></div>
                                <time class="text-gray-400 font-mono">00:15</time>
                                <p class="text-gray-600 mt-0.5">Waiting for customer to submit OTP</p>
                            </li>
                            <li class="ml-4">
                                <div class="absolute w-2.5 h-2.5 bg-green-500 rounded-full -left-[5px] top-1"></div>
                                <time class="text-gray-400 font-mono">00:33</time>
                                <p class="text-gray-900 font-semibold mt-0.5">Customer submitted OTP successfully</p>
                            </li>
                        </ol>
                    </div>

                </div>
            </div>
        </div>
    </main>

</body>
</html>
